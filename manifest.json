{
  "manifest_version": 3,
  "name": "Ukti - Bangla Voice Typing",
  "version": "1.0.1",
  "description": "Speak in Bangla, get text in any box. Bangla or English output. Also converts typed Banglish to Bangla.",
  "minimum_chrome_version": "138",
  "permissions": [
    "offscreen",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "উক্তি",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "setup.html",
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "banglish.js",
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "author": "Md Rashadul Islam",
  "homepage_url": "https://rashadul.me"
}