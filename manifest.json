{
  "manifest_version": 3,
  "name": "Ukti - Bangla Voice Typing",
  "version": "1.0.1",
  "description": "Speak in Bangla, get text in any box. Bangla or English output. Also converts typed Banglish to Bangla.",
  "minimum_chrome_version": "138",
  "permissions": [
    "offscreen",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "উক্তি",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "setup.html",
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "banglish.js",
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-dictation": {
      "suggested_key": {
        "default": "Ctrl+Shift+Space"
      },
      "description": "Start or stop speaking (বলা শুরু বা বন্ধ)"
    },
    "to-bangla": {
      "suggested_key": {
        "default": "Alt+Shift+1"
      },
      "description": "Banglish to Bangla (বাংলিশ থেকে বাংলা)"
    },
    "to-english": {
      "suggested_key": {
        "default": "Alt+Shift+2"
      },
      "description": "Make the text English (লেখাটা ইংরেজি)"
    },
    "undo": {
      "suggested_key": {
        "default": "Alt+Shift+3"
      },
      "description": "Undo Ukti's last change (ফেরত নিন)"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "homepage_url": "https://rashadul.me"
}
